# T-12 — keep image lean; context is repo root
.git
.gitignore
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
# frontend source is required by the web image build (frontend/Dockerfile);
# only build output and installed deps are excluded.
frontend/dist
frontend/node_modules
docs
data/uploads
data/duckdb
**/*.duckdb
**/.env
backend/_run_log.txt
**/*.md
!backend/requirements.txt

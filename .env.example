# AI BI Platform — local environment template
# Copy to .env and adjust. Never commit real secrets.
# Full matrix: docs/OPS_CONFIG_MATRIX.md

# PostgreSQL (docker-compose)
POSTGRES_USER=aibi
POSTGRES_PASSWORD=aibi_dev_password
POSTGRES_DB=aibi
# Host venv / browser tools: Compose maps host 5433 → container 5432
# (api/worker containers override to @postgres:5432 via docker-compose.yml)
DATABASE_URL=postgresql+psycopg://aibi:aibi_dev_password@localhost:5433/aibi

# Legacy local smoke without Docker (Phase 1 fallback only):
# DATABASE_URL=sqlite:///../data/aibi_phase1.db

# Redis (Phase 3+ task queue)
REDIS_URL=redis://localhost:6379/0

# Backend
APP_NAME=AI Business Intelligence Platform
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# T-08 — text (local) | json (structured / collectable)
LOG_FORMAT=text
LOG_LEVEL=INFO
# T-09 — Skill Lifecycle lite
SKILL_DATA_BI_ENABLED=true
SKILL_DATA_BI_VERSION=1.0.0
SKILL_DATA_PROFILE_ENABLED=true
SKILL_DATA_PROFILE_VERSION=1.0.0
# Wave 3 — optional MySQL RO plane (unset = disabled)
# MYSQL_RO_DSN=mysql://aibi_ro:password@localhost:3306/aibi_data
# Wave 3 — workspace linking memory
WORKSPACE_MEMORY_ENABLED=true
# Wave 3 — OIDC (disabled by default)
OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5173/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# T-10 — SSE Analyze progress (not LLM token streaming)
TASK_SSE_POLL_SECONDS=0.5
TASK_SSE_HEARTBEAT_SECONDS=5
TASK_SSE_MAX_SECONDS=600
JWT_SECRET=change-me-in-phase-1-use-a-long-random-string
# P0 Trust — short-lived access; longer refresh. Production/staging require strong JWT_SECRET (>=32, not default).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Redis rate limits (auth login/register + task create)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_TASK_CREATE_PER_MINUTE=60
# P1 — Worker HTTP health (:8001) + API Prometheus /metrics
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=8001
METRICS_ENABLED=true

# Paths (Phase 2) — relative paths resolve from repo root
UPLOAD_DIR=./data/uploads
DUCKDB_DIR=./data/duckdb
MAX_UPLOAD_BYTES=20971520

# Phase 3 — async skeleton
ANALYSIS_QUEUE_KEY=aibi:analysis_tasks
REDIS_BRPOP_TIMEOUT_SECONDS=5

# Phase 4 — analysis runtime: mock | agent
# Demo / staging / production: use agent. mock is local skeleton only.
# production|staging refuse to boot with ANALYSIS_RUNTIME=mock (P1.6).
ANALYSIS_RUNTIME=agent
SQL_DEFAULT_LIMIT=200
SQL_MAX_RETRIES=2
# Leave empty to use heuristic SQL (ALLOW_HEURISTIC_SQL=true) for local golden path
LLM_API_KEY=
# Wave 2: openai_compatible | anthropic | gemini (adjusts default base_url/model when empty)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
ALLOW_HEURISTIC_SQL=true
# Forced false when APP_ENV=production|staging (P0 config hardening)
# T-04 — recoverable LLM HTTP retries (timeout/transport/429/5xx). Not SQL graph retries.
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_RETRY_BACKOFF_MAX_SECONDS=8.0

# P0-2 Soft Cost Budget — workspace UTC-day LLM token soft cap (0 = disabled)
# Rejects new Analyze enqueue with 429 / budget_rejected; does not kill in-flight Runs.
LLM_TOKEN_BUDGET_PER_WORKSPACE_DAY=0

# Phase M2 — Run lifecycle
RUN_TIMEOUT_SECONDS=120

# Phase E3 — Runtime Essentials (capacity + reclaim)
RUN_MAX_IN_FLIGHT=4
ANALYSIS_QUEUE_MAX_DEPTH=50
# 0 => run_timeout_seconds + 60
STALE_RUNNING_SECONDS=0
RUN_HEARTBEAT_INTERVAL_SECONDS=15

# Phase M3 — enterprise data plane (separate from DATABASE_URL; optional)
# Host: postgres_ro on :5434. Compose api/worker override to @postgres_ro:5432
# Leave empty to skip M3 smoke in release gate
POSTGRES_RO_DSN=postgresql://aibi_ro:aibi_ro_password@localhost:5434/aibi_data

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
